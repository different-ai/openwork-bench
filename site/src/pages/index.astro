---
// The leaderboard. Its data is public/leaderboard.json, written before `astro build` by
// `owb demo` (offline) or `owb leaderboard --out site/public/leaderboard.json`.
import Site from '../layouts/Site.astro';
import Wordmark from '../components/Wordmark.astro';
import Info from '../components/Info.astro';
import { docs, embedJson, leaderboard, resultsUrl, route } from '../lib/site';

const data = embedJson(leaderboard());
const description = 'An open benchmark of open-weight AI models on real knowledge work: which ones you can trust, at what cost, speed and risk.';
---
<Site title="OpenWork Bench" description={description} active="leaderboard" footer={false}>
  <header class="hero" id="top">
    <div>
      <p class="eyebrow">Open models · Real work · Earned trust</p>
      <Wordmark class="wordmark" label="OpenWork Bench" />
      <h1>Which open models can you trust with real work?</h1>
      <p class="lede">Open-weight models take on everyday office work — email, calendar, documents, spreadsheets, CRM and chat — in a real agent app. Each is scored on quality, cost, speed and safety, then held to a clear bar for trust. <a href={docs("methodology")}>How it works</a></p>
    </div>
    <div class="updates" id="updates"></div>
  </header>

  <div id="leaderboard">
    <div class="toolbar">
      <div class="seg" role="group" aria-label="Board">
        <button type="button" data-board="open" aria-pressed="true">Open weights</button>
        <button type="button" data-board="all" aria-pressed="false">All models</button>
      </div>
      <div class="tool-r">
        <span>Harness<Info id="harness" /></span>
        <div class="seg small" role="group" aria-label="Harness">
          <button type="button" data-harness="openwork" aria-pressed="true" title="Tasks run in a desktop agent app (OpenWork)">Agent app</button>
          <button type="button" data-harness="control" aria-pressed="false" title="The same models in a plain tool-calling loop">Plain loop</button>
          <button type="button" data-harness="both" aria-pressed="false">Both</button>
        </div>
        <label title="Scripted and simulated agents that test the pipeline"><input type="checkbox" id="showTest" checked> Test agents</label>
      </div>
    </div>
    <div class="notice" id="notice" hidden></div>
    <div class="cards3">
      <div class="card">
        <h3><svg class="px" viewBox="0 0 2 2" aria-hidden="true"><rect width="2" height="2" fill="var(--f7)"/></svg>Work Index<Info id="work-index" /></h3>
        <p class="sub">How much of the work it gets right, 0–100 · higher is better · dashed lines are the readiness bars</p>
        <div class="chart" id="indexChart"></div>
      </div>
      <div class="card">
        <h3><svg class="px" viewBox="0 0 2 2" aria-hidden="true"><rect width="2" height="2" fill="var(--f4)"/></svg>Time per Task<Info id="time" /></h3>
        <p class="sub">How long you wait: minutes per task attempt · lower is better</p>
        <div class="chart" id="timeChart"></div>
      </div>
      <div class="card">
        <h3><svg class="px" viewBox="0 0 2 2" aria-hidden="true"><rect width="2" height="2" fill="var(--f2)"/></svg>Cost per Task<Info id="cost" /></h3>
        <p class="sub">What a task costs to run: USD per attempt · lower is better</p>
        <div class="chart" id="costChart"></div>
      </div>
    </div>
    <div class="legend" id="familyLegend"></div>
  </div>

  <div class="feature">
    <div class="dark-card" id="readiness">
      <div class="dither"></div>
      <h3>Which can you trust?</h3>
      <div class="tier" id="tiers"></div>
      <div class="foot">
        <p>Verdicts come from fixed bars, checked against a full run of every task.</p>
        <a class="btn light" href={route("readiness/")}>What readiness means <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="dark-card">
      <div class="dither"></div>
      <div><span class="chip">Reproduce</span><h3 style="margin-top:14px">Run any row yourself</h3></div>
      <pre>uv run owb models verify
uv run owb run glm-5.3@owb-agent
uv run owb world plan</pre>
      <div class="foot">
        <p>Weights pinned to a Hugging Face revision, serving pinned per call, every trajectory published.</p>
        <a class="btn light" href={docs("openwork-desktop")}>How runs work <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="changelog">
      <div class="cl-head"><h3>Changelog</h3><a class="btn soft small" href={route("changelog/")}>All changes <span aria-hidden="true">↗</span></a></div>
      <ul class="tl" id="changelog"></ul>
    </div>
  </div>

  <div class="explore">
    <nav class="sidenav" aria-label="Sections">
      <a href="#s-index">Work Index</a>
      <a href="#s-efficiency">Cost and speed</a>
      <a href="#s-tradeoffs">Quality vs. cost</a>
      <a href="#categories">Categories</a>
      <a href="#s-reliability">Reliability and safety</a>
      <a href="#results">All results</a>
      <a href="#tasks">Per-task scores</a>
    </nav>
    <div class="explore-main">
      <section class="block" id="s-index">
        <div class="block-head"><h2><i class="px" aria-hidden="true"></i>Work Index</h2><a class="btn soft" href={route("models/")}>All models <span aria-hidden="true">↗</span></a></div>
        <p class="sub">How much of the work each model gets right, held to the readiness bars.</p>
        <figure class="chart-card" id="c-index">
        
        <div class="cc-body">
          <div class="cc-head">
            <div><h3 class="cc-title"></h3><p class="sub cc-sub"></p><a class="cc-more" href="#"></a></div>
            <div class="cc-tools">
            <button type="button" data-act="link" title="Copy a link to this chart" aria-label="Copy a link to this chart"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"/></svg></button>
            <button type="button" data-act="png" title="Download as an image" aria-label="Download as an image"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14"/></svg></button>
            <button type="button" data-act="table" aria-pressed="false" title="Show as a table" aria-label="Show as a table"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM4 10h16M4 15h16M10 5v14"/></svg></button>
          </div>
          </div>
          <div class="chart"></div>
          <div class="cc-table scroll" hidden></div>
          <div class="legend cc-legend"></div>
        </div>
      </figure>
      </section>

      <section class="block" id="s-efficiency">
        <div class="block-head"><h2><i class="px" aria-hidden="true"></i>Cost and speed</h2></div>
        <p class="sub">What a task attempt costs, how long it takes and how much work the model does to get there.</p>
        <figure class="chart-card" id="c-efficiency">
        <div class="cc-tabs" role="tablist"></div>
        <div class="cc-body">
          <div class="cc-head">
            <div><h3 class="cc-title"></h3><p class="sub cc-sub"></p><a class="cc-more" href="#"></a></div>
            <div class="cc-tools">
            <button type="button" data-act="link" title="Copy a link to this chart" aria-label="Copy a link to this chart"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"/></svg></button>
            <button type="button" data-act="png" title="Download as an image" aria-label="Download as an image"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14"/></svg></button>
            <button type="button" data-act="table" aria-pressed="false" title="Show as a table" aria-label="Show as a table"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM4 10h16M4 15h16M10 5v14"/></svg></button>
          </div>
          </div>
          <div class="chart"></div>
          <div class="cc-table scroll" hidden></div>
          <div class="legend cc-legend"></div>
        </div>
      </figure>
      </section>

      <section class="block" id="s-tradeoffs">
        <div class="block-head"><h2><i class="px" aria-hidden="true"></i>Quality vs. cost</h2></div>
        <p class="sub">The best models sit up and to the left. The dotted line joins the models no other model beats on both axes.</p>
        <figure class="chart-card" id="c-tradeoffs">
        <div class="cc-tabs" role="tablist"></div>
        <div class="cc-body">
          <div class="cc-head">
            <div><h3 class="cc-title"></h3><p class="sub cc-sub"></p><a class="cc-more" href="#"></a></div>
            <div class="cc-tools">
            <button type="button" data-act="link" title="Copy a link to this chart" aria-label="Copy a link to this chart"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"/></svg></button>
            <button type="button" data-act="png" title="Download as an image" aria-label="Download as an image"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14"/></svg></button>
            <button type="button" data-act="table" aria-pressed="false" title="Show as a table" aria-label="Show as a table"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM4 10h16M4 15h16M10 5v14"/></svg></button>
          </div>
          </div>
          <div class="chart"></div>
          <div class="cc-table scroll" hidden></div>
          <div class="legend cc-legend"></div>
        </div>
      </figure>
      </section>

      <section class="block" id="categories">
        <div class="block-head"><h2><i class="px" aria-hidden="true"></i>Categories</h2></div>
        <p class="sub">What each model is good at: mean task score per kind of work, 0–100. ✓ marks a category at or above its target. Open a category for its tasks.</p>
        <div class="card scroll"><table id="catTable"></table></div>
      </section>

      <section class="block" id="s-reliability">
        <div class="block-head"><h2><i class="px" aria-hidden="true"></i>Reliability and safety</h2></div>
        <p class="sub">Whether you can count on it. <a href={route("metrics/first-try/")}>First-try success</a>: attempts fully right. <a href={route("metrics/every-time/")}>Right every time</a>: tasks solved on all three repeats. <a href={route("metrics/unsafe/")}>Unsafe actions</a>: attempts that deleted without being asked, emailed an unknown outside address or crossed a task's red line; they score 0.</p>
        <div class="card" id="relChart"></div>
      </section>

      <section class="block" id="results">
        <div class="block-head"><h2><i class="px" aria-hidden="true"></i>All results</h2></div>
        <p class="sub">Every number for every model. Hover a column's <span class="info static" aria-hidden="true">i</span> for what it means, or see <a href={route("metrics/")}>all metrics</a>.</p>
        <div class="card scroll"><table id="mainTable"></table></div>
      </section>

      <section class="block" id="tasks">
        <div class="block-head"><h2><i class="px" aria-hidden="true"></i>Per-task scores</h2><a class="btn soft" href={route("tasks/")}>All tasks <span aria-hidden="true">↗</span></a></div>
        <p class="sub">Mean score across repeats for each task. Hover a cell for details.</p>
        <div class="card scroll"><table class="matrix" id="matrix"></table></div>
      </section>
    </div>
  </div>

  <footer id="method">
    <div>
      <b style="color:var(--ink)">Method</b>
      <dl id="meta"></dl>
    </div>
    <div>
      <b style="color:var(--ink)">Open data</b>
      <p>Tasks, harness, graders and scoring: <a href="https://github.com/different-ai/openwork-bench">github.com/different-ai/openwork-bench</a>. Every published run, with its trajectories: <a href={resultsUrl()}>results</a>.</p>
      <p>Maintained by the OpenWork team under public <a href={docs("fair-play")}>fair-play rules</a>. <a href={route("readiness/")}>Readiness</a> · <a href={route("changelog/")}>Changelog</a></p>
    </div>
  </footer>

<script is:inline id="owb-data" type="application/json" set:html={data}></script>
<script>
  import "../scripts/leaderboard.js";
</script>
</Site>
