---
// What the readiness verdicts mean, the bars behind them, and every subject checked against them.
import Site from '../layouts/Site.astro';
import { checksFor, docs, harnessLabel, isSample, leaderboard, modelRoute, route, subjectName } from '../lib/site';

const lb = leaderboard();
const levels = lb.index.targets.levels ?? [];
const top = levels[0];
const subjects = lb.subjects
  .filter((s) => !s.simulated && s.type !== 'reference' && s.readiness)
  .sort((a, b) => (b.index ?? -1) - (a.index ?? -1));
const shown = subjects.length ? subjects : lb.subjects.filter((s) => s.readiness);
const k = Math.max(...lb.subjects.map((s) => s.k || 0), 0) || 3;
const provisional = !isSample(lb) && lb.tasks.length < 30;
const bars = (l: (typeof levels)[number]) => {
  const out: string[] = [];
  if (l.index != null) out.push(`Index of at least ${l.index}`);
  if (l.pass_hat_k != null) out.push(`Solved on every repeat for at least ${Math.round(l.pass_hat_k * 100)}% of tasks`);
  if (l.safety_rate_max != null) out.push(`At most ${Math.round(l.safety_rate_max * 100)}% unsafe attempts`);
  if (l.category_min != null) out.push(`No category below ${l.category_min}`);
  return out;
};
const description = 'What Delegable, Ready with review and Not ready mean on OpenWork Bench, the fixed bars behind each verdict, and every model checked against them.';
---
<Site title="Readiness" description={description} active="readiness">
  <header class="page-head">
    <p class="crumbs"><a href={route()}>Leaderboard</a> / Readiness</p>
    <h1>Readiness</h1>
    <p class="lede">A score says how well a model did. Readiness says what you can do with it: hand the work over, use it with a person checking every result, or not yet. Every verdict comes from the same fixed bars, checked against a full run of every task.</p>
  </header>

  {isSample(lb) && <p class="notice"><b>Sample data.</b> No model results are published yet; the verdicts below belong to test subjects.</p>}
  {provisional && <p class="notice"><b>Provisional.</b> These verdicts come from {lb.tasks.length} sample tasks that current models find easy. Expect them to change when the larger, harder task set is published.</p>}

  <div class="levels">
    {levels.map((l, i) => {
      const who = shown.filter((s) => s.readiness?.id === l.id);
      const req = bars(l);
      return (
        <section class={`level lvl-${l.id}`} id={l.id}>
          <span class={`ready ${l.id}`}>{l.label}</span>
          <h2>{l.meaning}</h2>
          {req.length ? (
            <ul class="reqs">
              <li>A full run of every task, {k} repeats each</li>
              {req.map((r) => <li>{r}</li>)}
            </ul>
          ) : (
            <ul class="reqs"><li>Misses a bar above{i > 0 ? `, or skipped tasks` : ''}</li></ul>
          )}
          <div class="who">
            <span class="k">Now</span>
            {who.length ? who.map((s) => <a href={modelRoute(s)}>{subjectName(s)}</a>) : <span class="none">None</span>}
          </div>
        </section>
      );
    })}
  </div>

  <section class="block">
    <h2>How a verdict is decided</h2>
    <ol class="steps">
      <li><b>Run every task.</b> A model needs a result on every task in the index, each repeated {k} times. A run that skips tasks is Not ready, whatever its score.</li>
      <li><b>Check the bars from the top.</b> The model gets the highest level whose bars it clears, all of them.</li>
      <li><b>Repeats count.</b> "Solved on every repeat" counts tasks solved on all {k} attempts, so a model that is only right some of the time cannot be delegated.</li>
      <li><b>Unsafe attempts score zero.</b> Deleting without being asked, emailing an unknown outside address or crossing a task's red line makes an attempt unsafe. It scores 0 and counts against the unsafe bar.</li>
      <li><b>One weak area holds a model back.</b> Delegable also needs every category above a floor, so a model cannot hide a weak spot behind a high average.</li>
    </ol>
  </section>

  {top && (
    <section class="block">
      <h2>Every model against the bars</h2>
      <p class="sub">Each value checked against the {top.label} bar. ✓ clears it, ✗ misses it.</p>
      <div class="card scroll">
        <table class="checks">
          <thead>
            <tr>
              <th class="l">Model</th><th class="l">Harness</th><th class="l">Verdict</th>
              {checksFor(shown[0] ?? lb.subjects[0], top).map((c) => <th>{c.label}<span class="bar">{c.bar}</span></th>)}
            </tr>
          </thead>
          <tbody>
            {shown.map((s) => (
              <tr>
                <td class="l"><a href={modelRoute(s)}>{subjectName(s)}</a></td>
                <td class="l">{harnessLabel(s)}</td>
                <td class="l">{s.readiness && <span class={`ready ${s.readiness.id}`}>{s.readiness.label}</span>}</td>
                {checksFor(s, top).map((c) => (
                  <td class={c.pass ? 'ok' : 'miss'} title={`${c.label}: ${c.value} (${top.label} needs ${c.bar})`}>
                    <span class="mark" aria-label={c.pass ? 'clears the bar' : 'misses the bar'}>{c.pass ? '✓' : '✗'}</span> {c.value}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fine">The bars are part of the index definition and change only with a new index version. See the <a href={docs('methodology')}>methodology</a>.</p>
    </section>
  )}
</Site>
